{
  "manifest_version": 3,
  "name": "Jev Mail \u2014 AI inbox triage",
  "version": "0.1.0",
  "description": "Triage your Gmail with TypeSafe's Jev model: category, priority, spam % and reply % for every message.",
  "minimum_chrome_version": "116",
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/content/gmail-overlay.js"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Jev Mail",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
